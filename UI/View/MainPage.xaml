<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UI"
    x:Name="decksPage"
    x:DataType="local:DecksViewModel"
    BackgroundColor="#F7F5FC">

    <VerticalStackLayout>

        <!--  Верхняя часть: название, поиск и кнопка  -->
        <Grid
            Padding="24,16"
            RowDefinitions="Auto,*"
            RowSpacing="6">

            <Label
                Grid.Row="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="✦ ПАМЯТЬ"
                TextColor="#7651C2"
                VerticalOptions="Center" />

            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="16"
                RowDefinitions="Auto,Auto">

                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="Мои колоды"
                        TextColor="#1E1B2E" />

                    <Label
                        FontSize="13"
                        Text="Все ваши воспоминания — в одном месте"
                        TextColor="#8B8698" />
                </VerticalStackLayout>

                <!--  Поиск и кнопка фильтра  -->
                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,16,0,0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        Padding="12,0"
                        BackgroundColor="White"
                        HeightRequest="44"
                        Stroke="#E8E3F3"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">

                            <Image
                                Grid.Column="0"
                                HeightRequest="16"
                                Opacity="0.45"
                                Source="search.png"
                                VerticalOptions="Center"
                                WidthRequest="16" />

                            <Entry
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                FontSize="14"
                                Placeholder="Найти колоду"
                                ReturnType="Search"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <ImageButton
                        Grid.Column="1"
                        Padding="12"
                        BackgroundColor="#EFE7FD"
                        CornerRadius="12"
                        HeightRequest="44"
                        Source="filter.png"
                        WidthRequest="44" />

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="LayoutStates">

                            <VisualState Name="Narrow">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>

                                <VisualState.Setters>
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                    <Setter Property="Margin" Value="0,16,0,0" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState Name="Wide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="800" />
                                </VisualState.StateTriggers>

                                <VisualState.Setters>
                                    <Setter Property="Grid.Row" Value="0" />
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                    <Setter Property="Margin" Value="0" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Padding="18,0"
                    BackgroundColor="#8D65CB"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="44"
                    Text="+ Новая карта"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!--  Белая область с колодами  -->
        <Border
            Margin="24,0"
            Padding="20"
            BackgroundColor="White"
            MinimumHeightRequest="450"
            StrokeShape="RoundRectangle 24"
            StrokeThickness="0">

            <VerticalStackLayout Spacing="16">

                <!--  Заголовок и кнопка новой колоды  -->
                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="КОЛОДЫ"
                        TextColor="#615A72"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="1"
                        Padding="16,0"
                        BackgroundColor="#8D65CB"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="34"
                        Text="+ Новая колода"
                        TextColor="White" />
                </Grid>

                <!--  Список колод  -->
                <ScrollView Margin="20,0">

                    <FlexLayout
                        Margin="24,16"
                        AlignItems="Start"
                        BindableLayout.ItemsSource="{Binding Decks}"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:DeckItemViewModel">

                                <VerticalStackLayout
                                    Margin="0,0,16,20"
                                    Spacing="8"
                                    WidthRequest="120">

                                    <!--  Переход по нажатию на колоду  -->
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.OpenDeckCommand, Source={x:Reference decksPage}}" CommandParameter="{Binding Id}" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Grid HeightRequest="150" WidthRequest="150">

                                        <!--  Задняя карточка стопки  -->
                                        <Border
                                            BackgroundColor="#E2D3F8"
                                            HeightRequest="140"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding HasMultipleCards}"
                                            Rotation="8"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0"
                                            TranslationX="10"
                                            TranslationY="4"
                                            VerticalOptions="Start"
                                            WidthRequest="100" />

                                        <!--  Средняя карточка стопки  -->
                                        <Border
                                            BackgroundColor="#D3BEF5"
                                            HeightRequest="140"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding HasTwoCards}"
                                            Rotation="4"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0"
                                            TranslationX="5"
                                            TranslationY="2"
                                            VerticalOptions="Start"
                                            WidthRequest="100" />

                                        <!--  Передняя карточка  -->
                                        <Border
                                            BackgroundColor="{Binding Color}"
                                            HeightRequest="140"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0"
                                            VerticalOptions="Start"
                                            WidthRequest="100">

                                            <Border.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsEmpty}"
                                                    TargetType="Border"
                                                    Value="True">

                                                    <Setter Property="BackgroundColor" Value="Transparent" />

                                                    <Setter Property="Stroke" Value="#C9B8E8" />

                                                    <Setter Property="StrokeThickness" Value="2" />

                                                    <Setter Property="StrokeDashArray" Value="6,4" />

                                                </DataTrigger>
                                            </Border.Triggers>

                                            <Image
                                                HeightRequest="28"
                                                HorizontalOptions="Center"
                                                Source="{Binding IconSource}"
                                                VerticalOptions="Center"
                                                WidthRequest="28" />
                                        </Border>
                                    </Grid>

                                    <!--  Название и количество карточек  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding Name}"
                                        TextColor="#1E1B2E" />

                                    <Label
                                        FontSize="12"
                                        Text="{Binding Caption}"
                                        TextColor="#8B8698" />

                                </VerticalStackLayout>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>