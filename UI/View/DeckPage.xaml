<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="UI.DeckPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UI"
    Title="Колода"
    x:DataType="local:DeckViewModel"
    BackgroundColor="#F7F5FC">

    <ScrollView>

        <VerticalStackLayout Padding="48,32" Spacing="16">

            <!--  Верхняя подпись  -->
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="✦ ПАМЯТЬ"
                TextColor="#7651C2" />
            <Label
                FontSize="13"
                Text="← Все колоды"
                TextColor="#8D65CB">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToDecksTapped" />
                </Label.GestureRecognizers>

            </Label>

            <!--  Заголовок и кнопка  -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

                <VerticalStackLayout Grid.Column="0" Spacing="4">

                    <Label
                        FontAttributes="Bold"
                        FontSize="30"
                        Text="{Binding Name}"
                        TextColor="#1E1B2E" />

                    <Label
                        FontSize="13"
                        Text="{Binding Caption}"
                        TextColor="#8B8698" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Padding="18,0"
                    BackgroundColor="#8D65CB"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontSize="12"
                    HeightRequest="40"
                    Text="+ Добавить карточку"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Grid>

            <FlexLayout
                Margin="0,12,0,0"
                AlignContent="SpaceEvenly"
                AlignItems="Start"
                BindableLayout.ItemsSource="{Binding Cards}"
                Direction="Row"
                JustifyContent="Center"
                Wrap="Wrap">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:CardViewModel">

                        <Border
                            Margin="8,0,8,24"
                            Padding="10"
                            BackgroundColor="White"
                            HeightRequest="420"
                            Stroke="#EEE9F4"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            WidthRequest="300">

                            <VerticalStackLayout Spacing="5">

                                <Border
                                    BackgroundColor="#D7C7EE"
                                    HeightRequest="105"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">

                                    <Grid>

                                        <Border
                                            BackgroundColor="#9782B0"
                                            HeightRequest="82"
                                            HorizontalOptions="Center"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            WidthRequest="54">

                                            <Grid>

                                                <Ellipse
                                                    Margin="0,12,0,0"
                                                    Fill="#F7E9E4"
                                                    HeightRequest="28"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Start"
                                                    WidthRequest="28" />

                                                <Label
                                                    FontSize="34"
                                                    HorizontalTextAlignment="Center"
                                                    Text="◆"
                                                    TextColor="#C5B5CB"
                                                    VerticalOptions="End" />

                                            </Grid>
                                        </Border>

                                    </Grid>
                                </Border>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Name}"
                                    TextColor="#1E1B2E" />

                                <Label
                                    FontSize="9"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="Автор"
                                    TextColor="#8B8698" />

                                <Label
                                    FontSize="10"
                                    Text="★ 4,8"
                                    TextColor="#9674C9" />

                                <Label
                                    FontSize="9"
                                    Text="Добавлено 10.11.2026"
                                    TextColor="#B2ACBA" />

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </FlexLayout>

            <Label
                FontSize="11"
                HorizontalTextAlignment="Center"
                Text="Конец"
                TextColor="#AAA3B3" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>